# Fail2Fix CMS (Payload)
# Copy to .env — never commit .env

DATABASE_URL=postgres://payload:your_password@localhost:5433/payload
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Marketing site cache revalidation
MARKETING_SITE_URL=https://fail2fix.co.uk
REVALIDATE_SECRET=change-me-shared-secret-with-marketing-site

# Docker Compose Postgres (if using docker-compose.yml)
POSTGRES_USER=payload
POSTGRES_PASSWORD=your_password
POSTGRES_DB=payload
